<%# ===== START PERSONALLY WRITTEN CODE ===== %>
<%# View file: views/attendee/confirmation.ejs. Renders server-side data provided by Express routes. %>
<%- include('../partials/header', { title: title, active: active }) %>
<section class="card narrow">
    <p class="eyebrow">Booking confirmation</p>
    <h1><%= booking.status === 'cancelled' ? 'Booking cancelled' : 'Booking confirmed' %></h1>
    <p class="reference">Reference: <strong><%= booking.booking_reference %></strong></p>
    <p><strong>Attendee:</strong> <%= booking.attendee_name %></p>
    <p><strong>Event:</strong> <%= booking.title %></p>
    <p><strong>Date:</strong> <%= formatDateTime(booking.event_date) %></p>
    <p><strong>Status:</strong> <span class="tag"><%= booking.status %></span></p>
    <% if (booking.cancelled_at) { %>
        <p><strong>Cancelled:</strong> <%= formatDateTime(booking.cancelled_at) %></p>
    <% } %>

    <%# Ticket line table: one booking may contain multiple ticket types. %>
    <table>
        <thead>
            <tr>
                <th>Ticket type</th>
                <th>Quantity</th>
                <th>Unit price</th>
                <th>Line total</th>
            </tr>
        </thead>
        <tbody>
            <% tickets.forEach(function(ticket) { %>
                <tr>
                    <td><%= ticket.ticket_type === 'full_price' ? 'Full price' : 'Concession' %></td>
                    <td><%= ticket.quantity %></td>
                    <td><%= formatMoney(ticket.unit_price) %></td>
                    <td><%= formatMoney(ticket.line_total) %></td>
                </tr>
            <% }); %>
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3">Total</th>
                <th><%= formatMoney(bookingTotal) %></th>
            </tr>
        </tfoot>
    </table>

    <div class="button-row">
        <a class="button secondary" href="/attendee">Back to Attendee Home Page</a>
        <%# Cancellation is only shown for active confirmed bookings. %>
        <% if (booking.status === 'confirmed') { %>
            <form action="/attendee/bookings/<%= booking.booking_reference %>/cancel" method="post" onsubmit="return confirm('Cancel this booking?');">
                <button class="button danger" type="submit">Cancel booking</button>
            </form>
        <% } %>
    </div>
</section>
<%- include('../partials/footer') %>
<%# ===== END PERSONALLY WRITTEN CODE ===== %>
